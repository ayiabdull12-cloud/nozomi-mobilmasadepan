{
  "name": "warung-raya",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "nodemon --watch server --ext js --exec \"node --env-file-if-exists=.env\" server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build:portable && playwright test",
    "build:portable": "node scripts/build-portable.mjs",
    "dev:toko": "node ecommerce/scripts/dev.mjs",
    "build:toko": "vite build --config ecommerce/vite.config.js",
    "start:toko": "node --env-file-if-exists=ecommerce/.env ecommerce/server.js",
    "test:toko": "node --test ecommerce/tests/*.test.js",
    "test:toko:e2e": "playwright test --config ecommerce/playwright.config.js",
    "build:toko-demo": "node ecommerce/scripts/build-demo.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "nodemon": "^3.1.14",
    "vite": "^7.1.0"
  }
}
