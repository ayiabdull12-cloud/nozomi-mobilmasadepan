# Salin menjadi ecommerce/.env; jangan unggah file .env atau password.
SHOP_HOST=127.0.0.1
SHOP_PORT=3003
SHOP_DATABASE_PATH=./data/aynetpremium.sqlite
SHOP_DEMO=false
# Isi kata sandi unik, minimal 12 karakter.
SHOP_ADMIN_PASSWORD=
# Saat dipasang di hosting, isi URL HTTPS tanpa garis miring akhir.
SHOP_PUBLIC_URL=

# Jika hosting memberi PORT, server memakainya saat SHOP_PORT tidak diisi.
# Opsional, hanya bila server berada di belakang proxy yang dipercaya: 1, 2, 3 atau loopback.
SHOP_TRUST_PROXY=
